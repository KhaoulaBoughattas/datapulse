{
  "title": "DataPulse — Pipeline Health",
  "uid": "datapulse-pipeline-health",
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {"type": "stat", "title": "Pipeline Success Rate (5m)", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
     "targets": [{"expr": "sum(rate(pipeline_success_total[5m])) / (sum(rate(pipeline_success_total[5m])) + sum(rate(pipeline_failure_total[5m])))", "legendFormat": "success rate"}]},
    {"type": "timeseries", "title": "Pipeline Successes vs Failures", "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0},
     "targets": [
       {"expr": "sum(rate(pipeline_success_total[5m])) by (pipeline_name)", "legendFormat": "{{pipeline_name}} success"},
       {"expr": "sum(rate(pipeline_failure_total[5m])) by (pipeline_name)", "legendFormat": "{{pipeline_name}} failure"}
     ]},
    {"type": "timeseries", "title": "Pipeline Duration (p50/p95)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
     "targets": [
       {"expr": "histogram_quantile(0.50, sum(rate(pipeline_duration_seconds_bucket[5m])) by (le, pipeline_name))", "legendFormat": "{{pipeline_name}} p50"},
       {"expr": "histogram_quantile(0.95, sum(rate(pipeline_duration_seconds_bucket[5m])) by (le, pipeline_name))", "legendFormat": "{{pipeline_name}} p95"}
     ]},
    {"type": "timeseries", "title": "Records Processed / sec", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
     "targets": [{"expr": "sum(rate(records_processed_total[5m])) by (pipeline_name)", "legendFormat": "{{pipeline_name}}"}]}
  ]
}
