# =============================================================================
# DataPulse — Environment Configuration Template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# NOTE: use .io/.dev/.com style emails, NOT .test/.example/.invalid —
# pydantic's email-validator rejects reserved TLDs.
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=datapulse
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=datapulse
POSTGRES_SOURCE_DB=datapulse_source
POSTGRES_TEST_DB=datapulse_test
POSTGRES_WAREHOUSE_DB=datapulse_warehouse

JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
API_ENV=local

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=datapulse
S3_REGION=us-east-1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

KAFKA_BOOTSTRAP_SERVERS=localhost:9094

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DATAPULSE_TRANSFORMER
SNOWFLAKE_WAREHOUSE=DATAPULSE_LOADING_WH
SNOWFLAKE_DATABASE=DATAPULSE_RAW
WAREHOUSE_BACKEND=

AIRFLOW_UID=50000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

DATA_ENCRYPTION_KEY=

ADMINER_PORT=8082

# Phase 17: generate via POST /api-keys as tenant OWNER, paste raw_key here
DATAPULSE_DAG_API_KEY=

# Phase 12
MARQUEZ_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=datapulse
